/*
 * secrets.h.example - Practica #5 (Diseño Electronico)
 *
 * COMO USARLO:
 *   1. Copia este archivo en la misma carpeta con el nombre "secrets.h".
 *   2. Reemplaza los valores por los tuyos.
 *
 * "secrets.h" esta listado en el .gitignore del repositorio, asi que nunca se
 * sube. Este archivo de ejemplo si se versiona, para que cualquiera que clone
 * el repositorio sepa que valores necesita.
 *
 * Este es el esquema que se adopta a partir de esta practica. En las practicas
 * 01-03 las credenciales iban como marcadores dentro del propio sketch, lo que
 * obligaba a acordarse de no commitear el archivo modificado. Separarlas en un
 * archivo ignorado elimina ese riesgo: no se puede subir por descuido.
 */

#ifndef SECRETS_H
#define SECRETS_H

// ---- Red WiFi a la que se conecta el ESP32 ----
// Debe ser la MISMA red donde corre el broker Mosquitto.
#define WIFI_SSID     "TU_WIFI_AQUI"
#define WIFI_PASSWORD "TU_PASSWORD_AQUI"

// ---- Broker MQTT (el PC donde corre Mosquitto) ----
// Es la IP local del PC, no "localhost": desde el ESP32, localhost seria el
// propio ESP32. Averiguala con "ipconfig" en Windows.
//
// OJO: si esa IP la asigna el router por DHCP puede cambiar tras un reinicio.
// Si el dispositivo deja de conectar, revisa este valor antes que el codigo.
#define MQTT_BROKER   "192.168.X.X"
#define MQTT_PORT     1883

#endif // SECRETS_H
