/*
 * secrets.h.example - Practica #6 (Diseño Electronico)
 *
 * COMO USARLO:
 *   1. Copia este archivo en la misma carpeta con el nombre "secrets.h".
 *   2. Reemplaza los valores por los tuyos.
 *
 * "secrets.h" esta en el .gitignore del repositorio: nunca se sube.
 */

#ifndef SECRETS_H
#define SECRETS_H

// ---- Red WiFi a la que se conecta el ESP32 ----
// A diferencia de la practica 05, YA NO tiene que ser la red del broker:
// el broker esta en Internet. Sirve cualquier red con salida a Internet
// (la de la casa, la de la universidad o el hotspot del celular), siempre que
// no bloquee el puerto 1883 de salida.
#define WIFI_SSID     "TU_WIFI_AQUI"
#define WIFI_PASSWORD "TU_PASSWORD_AQUI"

// ---- Broker MQTT (la instancia EC2) ----
// IP publica de la instancia (o su "Public IPv4 DNS"). Se ve en la consola de
// EC2, en el detalle de la instancia.
//
// OJO: si la instancia se DETIENE y se vuelve a arrancar, AWS le asigna otra
// IP publica. Si el ESP32 deja de conectar tras reiniciar la instancia,
// revisa este valor antes que el codigo. Una Elastic IP evita el problema.
#define MQTT_BROKER   "X.X.X.X"
#define MQTT_PORT     1883

// ---- Credenciales MQTT ----
// El broker esta expuesto a Internet, asi que NO admite clientes anonimos.
// Usuario creado en la instancia con:  sudo mosquitto_passwd /etc/mosquitto/passwd <usuario>
// (cada dispositivo puede tener su propio usuario).
#define MQTT_USER     "TU_USUARIO_MQTT"
#define MQTT_PASS     "TU_PASSWORD_MQTT"

#endif // SECRETS_H
