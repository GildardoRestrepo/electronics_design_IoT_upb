  {
    "id": "in_sw",
    "type": "mqtt in",
    "z": "flow_p6",
    "name": "sw",
    "topic": "gilbert/ttgo/sw",
    "qos": "1",
    "datatype": "utf8",
    "broker": "broker_aws",
