    "inputs": 0,
    "x": 130,
    "y": 260,
    "wires": [
      [
        "fn_sw"
      ]
    ]
  },
  {
    "id": "fn_sw",
    "type": "function",
    "z": "flow_p6",
    "name": "formatear sw",
    "func": "// El sensor publica el sw RETENIDO: '1' pulsado, '0' libre.\nvar on = (msg.payload === '1');\nmsg.payload = on ? 'PULSADO' : 'libre';\nmsg.color = on ? '#e6a700' : '#888888';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 260,
    "wires": [
      [
        "txt_sw"
      ]
    ]
  },
