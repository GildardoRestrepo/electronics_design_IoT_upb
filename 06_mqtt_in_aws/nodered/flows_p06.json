    "name": "",
    "label": "Boton del TTGO (sw)",
    "format": "<font color=\"{{msg.color}}\"><b>{{msg.payload}}</b></font>",
    "layout": "row-spread",
    "className": "",
    "x": 640,
    "y": 260,
    "wires": []
  },
  {
    "id": "in_estado",
    "type": "mqtt in",
    "z": "flow_p6",
    "name": "estado sensor (LWT)",
    "topic": "gilbert/ttgo/estado",
    "qos": "1",
    "datatype": "utf8",
