  },
  {
    "id": "fn_estado",
    "type": "function",
    "z": "flow_p6",
    "name": "formatear estado",
    "func": "// El broker publica 'offline' aqui por su cuenta si el cliente desaparece\n// sin despedirse (Last Will and Testament declarado al conectar).\nvar vivo = (msg.payload === 'online');\nmsg.payload = vivo ? 'CONECTADO' : 'DESCONECTADO';\nmsg.color = vivo ? '#00b500' : '#ca3838';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 340,
    "wires": [
